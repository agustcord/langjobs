{
  "manifest_version": 3,
  "name": "LangJobs — Job Language Filter for LinkedIn",
  "version": "0.5.6",
  "description": "Etiqueta y filtra vacantes de LinkedIn por idioma (ES/EN). El detector corre 100% local en el DOM; solo las vacantes dudosas consultan el endpoint público de LinkedIn para resolver el idioma.",
  "author": "agustcord",
  "homepage_url": "https://github.com/agustcord/langjobs",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/jobs/*",
    "https://linkedin.com/jobs/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://linkedin.com/jobs/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
